[Unit]
Description=Nuxt Personal Blog
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Restart=always
WorkingDirectory=/var/www/html/personal-blog
# Using 'node' directly; systemd will find it if it's in the system path
ExecStart=/home/ubuntu/.nvm/versions/node/v22.22.2/bin/node .output/server/index.mjs

# Environment variables
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=NITRO_HOST=127.0.0.1

[Install]
WantedBy=multi-user.target
